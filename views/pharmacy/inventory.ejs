<div class="d-flex justify-content-between mb-3"><h4>Medicine & Inventory Master</h4><a href="/pharmacy/batches" class="btn btn-outline-secondary">Batch / Expiry</a></div><form class="row g-2 mb-3"><div class="col-md-6"><input name="q" value="<%=q%>" class="form-control" placeholder="Search medicine, generic or SKU"></div><div class="col-auto"><button class="btn btn-primary">Search</button></div></form><div class="card mb-3"><div class="card-header">Create Medicine SKU</div><div class="card-body"><form method="POST" class="row g-2" action="/pharmacy/inventory/medicines"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><div class="col-md-3"><input required name="name" class="form-control" placeholder="Medicine"></div><div class="col-md-2"><input name="genericName" class="form-control" placeholder="Generic"></div><div class="col-md-2"><input name="strength" class="form-control" placeholder="Strength"></div><div class="col-md-2"><input name="dosageForm" class="form-control" placeholder="Form"></div><div class="col-md-1"><input name="mrp" type="number" step=".01" class="form-control" placeholder="MRP"></div><div class="col-md-1"><input name="saleRate" type="number" step=".01" class="form-control" placeholder="Sale"></div><div class="col-md-1"><input name="reorderLevel" type="number" step=".001" class="form-control" placeholder="Reorder"></div><div class="col-12"><button class="btn btn-success">Create</button></div></form></div></div><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>SKU</th><th>Medicine</th><th>Generic</th><th>MRP</th><th>Sale</th><th>Stock</th><th>Expiry</th></tr></thead><tbody><%medicines.forEach(m=>{%><tr><td><code><%=m.sku%></code></td><td><%=m.name%> <small class="text-muted"><%=m.strength||''%> <%=m.dosage_form||''%></small></td><td><%=m.generic_name||'—'%></td><td>₹<%=Number(m.mrp).toFixed(2)%></td><td>₹<%=Number(m.sale_rate).toFixed(2)%></td><td><%=m.stock_qty%></td><td><%=m.nearest_expiry?new Date(m.nearest_expiry).toLocaleDateString():'—'%></td></tr><%})%></tbody></table></div></div>