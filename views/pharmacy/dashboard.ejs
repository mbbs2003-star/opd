<div class="d-flex justify-content-between mb-3"><div><h4>Pharmacy ERP & Medical Store</h4><div class="text-muted">POS · Inventory · Procurement · Accounting</div></div><a class="btn btn-primary" href="/pharmacy/sales/new">New Bill</a></div><div class="row g-3"><%[['Today Sales','₹'+Number(sales.sales).toFixed(2)],['Bills',sales.bills],['Stock Value','₹'+Number(stock.stock_value).toFixed(2)],['Low Stock',stock.low_stock],['Near Expiry',stock.near_expiry],['Purchases','₹'+Number(purchases.purchases).toFixed(2)]].forEach(x=>{%><div class="col-md-4 col-xl-2"><div class="card h-100"><div class="card-body"><small class="text-muted"><%=x[0]%></small><div class="fs-5 fw-semibold"><%=x[1]%></div></div></div></div><%})%></div><div class="row g-3 mt-1"><div class="col-lg-8"><div class="card"><div class="card-header">Low Stock</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>SKU</th><th>Medicine</th><th>Stock</th><th>Reorder</th></tr></thead><tbody><%low.forEach(x=>{%><tr><td><%=x.sku%></td><td><%=x.name%></td><td><%=x.quantity%></td><td><%=x.reorder_level%></td></tr><%})%></tbody></table></div></div></div><div class="col-lg-4"><div class="card"><div class="card-header">Operations</div><div class="list-group list-group-flush"><a class="list-group-item" href="/pharmacy/inventory">Medicine / Inventory</a><a class="list-group-item" href="/pharmacy/batches">Batch / Expiry</a><a class="list-group-item" href="/pharmacy/purchases/new">Purchase / GRN</a><a class="list-group-item" href="/pharmacy/sales">Sales</a><a class="list-group-item" href="/pharmacy/suppliers">Suppliers</a><a class="list-group-item" href="/pharmacy/accounts">Accounts / Expenses</a></div></div></div></div>