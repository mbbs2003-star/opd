<h4 class="mb-3">Suppliers / Vendors</h4><div class="card mb-3"><div class="card-body"><form method="POST" class="row g-2"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><div class="col-md-3"><input required name="name" class="form-control" placeholder="Supplier"></div><div class="col-md-2"><input name="gstin" class="form-control" placeholder="GSTIN"></div><div class="col-md-2"><input name="drugLicenseNo" class="form-control" placeholder="Drug licence"></div><div class="col-md-2"><input name="mobile" class="form-control" placeholder="Mobile"></div><div class="col-md-3"><input name="address" class="form-control" placeholder="Address"></div><div class="col-12"><button class="btn btn-success">Add Supplier</button></div></form></div></div><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Code</th><th>Supplier</th><th>GSTIN</th><th>Drug Licence</th><th>Mobile</th></tr></thead><tbody><%suppliers.forEach(s=>{%><tr><td><%=s.supplier_code%></td><td><%=s.name%></td><td><%=s.gstin||'—'%></td><td><%=s.drug_license_no||'—'%></td><td><%=s.mobile||'—'%></td></tr><%})%></tbody></table></div></div>