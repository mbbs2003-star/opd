<h4 class="mb-3">Pharmacy Accounting & Expenses</h4><div class="card mb-3"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Code</th><th>Account</th><th>Type</th><th>Balance</th></tr></thead><tbody><%rows.forEach(a=>{%><tr><td><%=a.code%></td><td><%=a.name%></td><td><%=a.account_type%></td><td>₹<%=Number(a.balance).toFixed(2)%></td></tr><%})%></tbody></table></div></div><div class="card"><div class="card-header">Record Expense</div><div class="card-body"><form method="POST" action="/pharmacy/accounts/expenses" class="row g-2"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><div class="col-md-2"><input required name="category" class="form-control" placeholder="Category"></div><div class="col-md-3"><input name="description" class="form-control" placeholder="Description"></div><div class="col-md-2"><input required name="amount" type="number" step=".01" class="form-control" placeholder="Amount"></div><div class="col-md-2"><select name="paymentMethod" class="form-select"><option>CASH</option><option>UPI</option><option>CARD</option><option>BANK</option></select></div><div class="col-md-2"><input name="referenceNumber" class="form-control" placeholder="Reference"></div><div class="col-md-1"><button class="btn btn-success">Save</button></div></form></div></div>