<h4 class="mb-3">Purchase / Goods Receipt</h4><div class="card"><div class="card-body"><form method="POST" action="/pharmacy/purchases" id="pf"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="itemsJson" id="itemsJson"><div class="row g-2"><div class="col-md-4"><select required name="supplierId" class="form-select"><option value="">Supplier</option><%suppliers.forEach(s=>{%><option value="<%=s.id%>"><%=s.name%></option><%})%></select></div><div class="col-md-3"><input name="supplierInvoiceNo" class="form-control" placeholder="Supplier invoice"></div><div class="col-md-3"><input name="purchaseDate" type="date" value="<%=new Date().toISOString().slice(0,10)%>" class="form-control"></div></div><div class="table-responsive mt-3"><table class="table" id="pi"><thead><tr><th>Medicine</th><th>Batch</th><th>Expiry</th><th>Qty</th><th>Rate</th><th>MRP</th><th>GST</th></tr></thead><tbody></tbody></table></div><button type="button" id="add" class="btn btn-outline-primary">Add item</button><div class="row mt-3"><div class="col-md-3"><input name="discountAmount" class="form-control" value="0" placeholder="Discount"></div><div class="col-md-3"><input name="paidAmount" class="form-control" value="0" placeholder="Paid"></div></div><button class="btn btn-success mt-3">Post Purchase</button></form></div></div><script>const M=<%-JSON.stringify(medicines)%>,tb=document.querySelector('#pi tbody');function add(){const t=document.createElement('tr');t.innerHTML='<td><select class="form-select m"><option value="">Select</option>'+M.map(x=>'<option value="'+x.id+'">'+x.name+' ('+x.sku+')</option>').join('')+'</select></td><td><input class="form-control b"></td><td><input class="form-control e" type="date"></td><td><input class="form-control q" type="number" value="1"></td><td><input class="form-control r" type="number" step=".01"></td><td><input class="form-control mrp" type="number" step=".01"></td><td><input class="form-control g" type="number" step=".01" value="0"></td>';tb.appendChild(t);t.querySelector('.m').onchange=()=>{const x=M.find(y=>String(y.id)===t.querySelector('.m').value);if(x){t.querySelector('.r').value=x.purchase_rate;t.querySelector('.mrp').value=x.mrp;t.querySelector('.g').value=x.gst_rate}}}document.querySelector('#add').onclick=add;add();document.querySelector('#pf').onsubmit=()=>{document.querySelector('#itemsJson').value=JSON.stringify([...tb.querySelectorAll('tr')].map(t=>({medicineId:t.querySelector('.m').value,batchNumber:t.querySelector('.b').value,expiryDate:t.querySelector('.e').value,quantity:t.querySelector('.q').value,purchaseRate:t.querySelector('.r').value,mrp:t.querySelector('.mrp').value,gstRate:t.querySelector('.g').value})).filter(x=>x.medicineId));return true}</script>