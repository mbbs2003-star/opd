<h4 class="mb-3">Pharmacy POS / Medical-Store Bill</h4><div class="card"><div class="card-body"><form method="POST" action="/pharmacy/sales" id="saleForm"><input type="hidden" name="_csrf" value="<%=csrfToken%>"><input type="hidden" name="itemsJson" id="itemsJson"><div class="row g-2"><div class="col-md-4"><label>Patient (optional)</label><select name="patientId" class="form-select"><option value="">Normal / Walk-in Customer</option><%patients.forEach(p=>{%><option value="<%=p.id%>"><%=p.health_id%> — <%=p.name%></option><%})%></select></div><div class="col-md-3"><label>Customer name</label><input name="customerName" class="form-control" placeholder="For non-patient"></div><div class="col-md-3"><label>Mobile</label><input name="customerMobile" class="form-control"></div><div class="col-md-2"><label>Prescription ID</label><input name="prescriptionId" class="form-control" placeholder="Optional"></div></div><div class="table-responsive mt-3"><table class="table" id="items"><thead><tr><th>Batch</th><th>Medicine</th><th>Expiry</th><th>Price</th><th>Qty</th><th>Discount</th><th></th></tr></thead><tbody></tbody></table></div><button type="button" id="add" class="btn btn-outline-primary">Add medicine</button><hr><div class="row g-2"><div class="col-md-3"><label>Payment</label><select name="paymentMethod" class="form-select"><option>CASH</option><option>UPI</option><option>CARD</option><option>CREDIT</option></select></div><div class="col-md-3"><label>Paid amount</label><input name="paidAmount" type="number" step=".01" value="0" class="form-control"></div><div class="col-md-3"><label>Reference</label><input name="referenceNumber" class="form-control"></div><div class="col-md-3"><label>Notes</label><input name="notes" class="form-control"></div></div><button class="btn btn-success mt-3">Generate Bill & Update Stock</button></form></div></div><script>const B=<%-JSON.stringify(batches)%>,tb=document.querySelector('#items tbody');function add(){const t=document.createElement('tr');t.innerHTML='<td><select class="form-select b"><option value="">Select</option>'+B.map(x=>'<option value="'+x.id+'">'+x.sku+' | '+x.batch_number+' | '+x.quantity+'</option>').join('')+'</select></td><td class="n">—</td><td class="e">—</td><td><input class="form-control p" type="number" step=".01"></td><td><input class="form-control q" type="number" step=".001" min=".001" value="1"></td><td><input class="form-control d" type="number" step=".01" value="0"></td><td><button type="button" class="btn btn-sm btn-danger x">×</button></td>';tb.appendChild(t);t.querySelector('.b').onchange=()=>{const x=B.find(y=>String(y.id)===t.querySelector('.b').value);t.querySelector('.n').textContent=x?x.name:'—';t.querySelector('.e').textContent=x?new Date(x.expiry_date).toLocaleDateString():'—';t.querySelector('.p').value=x?(x.sale_rate||x.mrp):0};t.querySelector('.x').onclick=()=>t.remove()}document.querySelector('#add').onclick=add;add();document.querySelector('#saleForm').onsubmit=()=>{const a=[...tb.querySelectorAll('tr')].map(t=>({batchId:t.querySelector('.b').value,quantity:t.querySelector('.q').value,unitPrice:t.querySelector('.p').value,discount:t.querySelector('.d').value})).filter(x=>x.batchId);document.querySelector('#itemsJson').value=JSON.stringify(a);if(!a.length){alert('Add a medicine');return false}return true}</script>