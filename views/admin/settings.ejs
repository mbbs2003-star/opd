<h4 class="mb-3">Site Settings</h4>

<form method="POST" action="/admin/settings" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="card mb-3 border-warning">
    <div class="card-header bg-warning-subtle d-flex justify-content-between align-items-center">
      <span><i class="bi bi-tools me-1"></i> Maintenance Mode</span>
      <span class="badge text-bg-danger">SUPER ADMIN ONLY</span>
    </div>
    <div class="card-body">
      <div class="form-check form-switch">
        <input type="hidden" name="maintenance_mode" value="0">
        <input class="form-check-input" type="checkbox" name="maintenance_mode" value="1" id="maintenanceMode" <%= settings.maintenance_mode === '1' ? 'checked' : '' %>>
        <label class="form-check-label fw-semibold" for="maintenanceMode">Enable site-wide maintenance mode</label>
      </div>
      <p class="text-muted small mt-2 mb-2">
        When enabled, all authenticated and public application areas are blocked for non-Super-Admins and return a maintenance screen.
        Super Admin accounts retain full access so they can perform maintenance and turn this switch off.
      </p>
      <div class="alert alert-warning small mb-0">
        <strong>Important:</strong> authentication remains available so a Super Admin can sign in during maintenance. No other role can access the HMS, patient portal, OPD, doctors, billing, LIS, reports, or admin modules.
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header">Branding</div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Hospital Name</label>
          <input type="text" name="hospital_name" class="form-control" value="<%= settings.hospital_name %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Tagline</label>
          <input type="text" name="hospital_tagline" class="form-control" value="<%= settings.hospital_tagline %>">
        </div>
      </div>
      <hr class="my-3">
      <div class="row g-3 align-items-end">
        <div class="col-md-4">
          <label class="form-label">Logo <small class="text-muted">(used on printed letterheads and the sidebar)</small></label>
          <input type="file" name="logo" class="form-control" accept="image/png,image/jpeg,image/svg+xml,image/webp">
        </div>
        <div class="col-md-2 text-center">
          <% if (settings.logo_path) { %><img src="<%= settings.logo_path %>" alt="Current logo" style="max-height:60px;max-width:100%;"><% } else { %><span class="text-muted small">No logo set</span><% } %>
        </div>
        <div class="col-md-4">
          <label class="form-label">Favicon</label>
          <input type="file" name="favicon" class="form-control" accept="image/x-icon,image/png,image/svg+xml">
        </div>
        <div class="col-md-2 text-center">
          <% if (settings.favicon_path) { %><img src="<%= settings.favicon_path %>" alt="Favicon" style="height:24px;"><% } %>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header">Live OPD (Public Page)</div>
    <div class="card-body">
      <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" name="live_opd_show_names" value="1" id="liveOpdNames" <%= settings.live_opd_show_names === '1' ? 'checked' : '' %>>
        <label class="form-check-label" for="liveOpdNames">Show patient names on the public Live OPD page</label>
      </div>
      <div class="alert alert-warning small mt-2 mb-0">
        <strong>Privacy note:</strong> the Live OPD page at <code>/live-opd</code> is public. Turn this off to show only token numbers and statuses.
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header">Contact Information</div>
    <div class="card-body row g-3">
      <div class="col-md-4"><label class="form-label">Phone</label><input type="text" name="contact_phone" class="form-control" value="<%= settings.contact_phone %>"></div>
      <div class="col-md-4"><label class="form-label">Email</label><input type="email" name="contact_email" class="form-control" value="<%= settings.contact_email %>"></div>
      <div class="col-md-12"><label class="form-label">Address</label><input type="text" name="contact_address" class="form-control" value="<%= settings.contact_address %>"></div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header">SEO &amp; Social Sharing</div>
    <div class="card-body">
      <div class="mb-3"><label class="form-label">Page Title</label><input type="text" name="seo_title" class="form-control" maxlength="70" value="<%= settings.seo_title %>"></div>
      <div class="mb-3"><label class="form-label">Meta Description</label><textarea name="seo_description" class="form-control" rows="2" maxlength="160"><%= settings.seo_description %></textarea></div>
      <div class="mb-3"><label class="form-label">Keywords</label><input type="text" name="seo_keywords" class="form-control" value="<%= settings.seo_keywords %>"></div>
      <div class="mb-2"><label class="form-label">Social Share Image (Open Graph)</label><input type="file" name="og_image" class="form-control" accept="image/png,image/jpeg,image/webp">
        <% if (settings.og_image_path) { %><img src="<%= settings.og_image_path %>" class="mt-2" style="max-width:240px;border-radius:.4rem;"><% } %>
      </div>
    </div>
  </div>

  <div class="text-end"><button type="submit" class="btn btn-primary">Save Settings</button></div>
</form>
