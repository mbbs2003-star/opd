<div class="d-flex justify-content-between align-items-center mb-3"><div><h4>Laboratory Test Master</h4><div class="text-muted small">Dynamic tests, USG, ECG and result parameters</div></div><% if (currentUser && currentUser.permissions.includes("lab.manage")) { %><a href="/lab/tests/new" class="btn btn-primary btn-sm">Add Test</a><% } %></div>
<form class="card card-body mb-3" method="GET"><div class="row g-2"><div class="col-md-6"><input name="q" class="form-control" placeholder="Search test name/code" value="<%= filters.q || '' %>"></div><div class="col-md-3"><select name="testType" class="form-select"><option value="">All types</option><% ['LAB','RADIOLOGY','USG','ECG','CARDIOLOGY','OTHER'].forEach(function(x){ %><option value="<%= x %>"><%= x %></option><% }) %></select></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Search</button></div></div></form>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Code</th><th>Test</th><th>Section</th><th>Type</th><th>Specimen</th><th>TAT</th><th>Price</th><th></th></tr></thead><tbody><% tests.forEach(function(t){ %><tr><td><code><%= t.code %></code></td><td><strong><%= t.name %></strong><% if(t.is_accredited){ %><span class="badge text-bg-success ms-1">Accredited scope</span><% } %></td><td><%= t.section_name||'—' %></td><td><%= t.test_type %></td><td><%= t.specimen_type||'—' %></td><td><%= Math.ceil(Number(t.tat_minutes||0)/60) %>h</td><td>₹<%= Number(t.price||0).toFixed(2) %></td><td><a href="/lab/tests/<%= t.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a></td></tr><% }) %></tbody></table></div></div>