<div class="d-flex justify-content-between align-items-center mb-3"><div><h4>Enter Result</h4><div class="text-muted"><%= item.test_name_snapshot %> · <%= order.order_code %> · <%= order.patient_name %></div></div><a href="/lab/orders/<%= order.id %>" class="btn btn-outline-secondary btn-sm">Back</a></div>
<form method="POST" action="/lab/items/<%= item.id %>/result"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="card mb-3"><div class="card-body"><div class="row g-3"><div class="col-md-4"><label class="form-label">Instrument</label><input name="instrumentName" class="form-control" value="<%= result ? (result.result.instrument_name||'') : '' %>"></div><div class="col-md-4"><label class="form-label">Method</label><input name="methodUsed" class="form-control" value="<%= result ? (result.result.method_used||test.test.methodology||'') : (test.test.methodology||'') %>"></div><div class="col-md-4"><label class="form-label">Overall result / summary</label><input name="resultSummary" class="form-control" value="<%= result ? (result.result.result_summary||'') : '' %>"></div></div></div></div>
<div class="card mb-3"><div class="card-header"><strong>Parameters</strong><span class="small text-muted ms-2">Reference intervals are configuration data; the laboratory must validate them before clinical use.</span></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Parameter</th><th>Result</th><th>Unit</th><th>Reference</th><th>Flag</th><th>Remarks</th></tr></thead><tbody>
<% test.parameters.forEach(function(p){ const value=result&&result.parameters.find(function(x){return Number(x.id)===Number(p.id);}); %><tr><td><strong><%= p.name %></strong><input type="hidden" name="parameterIds" value="<%= p.id %>"></td><td><input class="form-control" name="values[<%= p.id %>]" value="<%= value ? (value.value_text||'') : '' %>" <%= result&&result.result.status==='RELEASED'?'readonly':'' %>></td><td><%= p.unit||'—' %></td><td><%= p.reference_range_text||'—' %></td><td><%= value ? value.abnormal_flag : 'Auto' %></td><td><input class="form-control" name="remarks[<%= p.id %>]" value="<%= value ? (value.remarks||'') : '' %>"></td></tr><% }) %>
</tbody></table></div></div>
<div class="card mb-3"><div class="card-body"><label class="form-label">Interpretation</label><textarea name="interpretation" class="form-control mb-2" rows="3"><%= result ? (result.result.interpretation||'') : '' %></textarea><label class="form-label">Comments / limitations</label><textarea name="comments" class="form-control" rows="3"><%= result ? (result.result.comments||'') : '' %></textarea></div></div>
<div class="text-end"><button class="btn btn-primary">Save Result</button></div></form>