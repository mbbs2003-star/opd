    <img src="/images/chhayabithi-logo.webp" alt="CHHAYABITHI logo" class="letterhead-logo" width="220" height="68">
  </div>
  <div class="hospital-sub"><%= typeof siteSettings !== 'undefined' ? siteSettings.hospital_tagline : 'Multi-Specialty Clinic & Diagnostic Centre' %></div>
  <div class="hospital-addr"><%= typeof siteSettings !== 'undefined' ? siteSettings.contact_address : '' %></div>
  <div class="hospital-addr">
