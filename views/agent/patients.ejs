<div class="d-flex justify-content-between align-items-center mb-3"><div><h4 class="mb-1">Agent Patient List</h4><div class="small text-muted">Shows who registered the patient and who booked the latest OPD.</div></div><a class="btn btn-primary" href="/agent/patients/new">Register Patient</a></div>
<form class="card card-body mb-3"><div class="input-group"><input name="q" class="form-control" value="<%= q %>" placeholder="Health ID, registration number, name or mobile"><button class="btn btn-outline-primary">Search</button></div></form>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Patient</th><th>Health ID</th><th>Registered By</th><th>Latest OPD Booked By</th><th>Referral</th><th>Actions</th></tr></thead><tbody>
<% patients.forEach(function(p){ %><tr><td><strong><%= p.name %></strong><div class="small text-muted"><%= p.gender %> · <%= p.age_years || '—' %> yrs · <%= p.mobile %></div></td><td><code><%= p.health_id %></code><div class="small"><%= p.registration_number %></div></td><td><%= p.registered_by || '—' %><div class="small text-muted"><%= p.registered_by_role || '' %></div></td><td><%= p.latest_booked_by || '—' %><div class="small text-muted"><%= p.latest_booked_by_role || '' %></div></td><td><code><%= p.latest_opd_referral || p.referral_code || '—' %></code></td><td><a class="btn btn-sm btn-outline-primary" href="/patients/<%= p.health_id %>">Profile</a> <a class="btn btn-sm btn-outline-success" href="/agent/opd/new?healthId=<%= encodeURIComponent(p.health_id) %>">OPD</a> <a class="btn btn-sm btn-outline-secondary" href="/agent/tests/new?healthId=<%= encodeURIComponent(p.health_id) %>">Test</a></td></tr><% }) %><% if(!patients.length){ %><tr><td colspan="6" class="text-center text-muted py-4">No agent-attributed patients found.</td></tr><% } %></tbody></table></div></div>