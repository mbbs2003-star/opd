<div class="d-flex justify-content-between align-items-center mb-3"><h4>Register Patient</h4><a href="/agent/patients" class="btn btn-outline-secondary btn-sm">Back</a></div>
<form method="POST" action="/agent/patients"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="card"><div class="card-body"><div class="row g-3">
<div class="col-md-8"><label class="form-label">Patient Name *</label><input name="name" class="form-control" required></div>
<div class="col-md-4"><label class="form-label">Gender *</label><select name="gender" class="form-select" required><option value="">Select</option><option>Male</option><option>Female</option><option>Other</option></select></div>
<div class="col-md-4"><label class="form-label">DOB</label><input type="date" name="dob" class="form-control" max="<%= today %>"></div>
<div class="col-md-4"><label class="form-label">Mobile *</label><input name="mobile" class="form-control" required></div>
<div class="col-md-4"><label class="form-label">Email</label><input type="email" name="email" class="form-control"></div>
<div class="col-md-6"><label class="form-label">Father Name</label><input name="fatherName" class="form-control"></div>
<div class="col-md-6"><label class="form-label">Husband Name</label><input name="husbandName" class="form-control"></div>
<div class="col-md-6"><label class="form-label">Address</label><input name="address" class="form-control"></div>
<div class="col-md-3"><label class="form-label">District</label><input name="district" class="form-control"></div>
<div class="col-md-3"><label class="form-label">PIN</label><input name="pinCode" class="form-control"></div>
<div class="col-md-6"><label class="form-label">Village / Town</label><input name="villageTown" class="form-control"></div>
<div class="col-md-6"><label class="form-label">Police Station</label><input name="policeStation" class="form-control"></div>
<div class="col-md-6"><label class="form-label">State</label><input name="state" class="form-control" value="West Bengal"></div>
<div class="col-md-6"><label class="form-label">Referral Number / Code *</label><input name="referralCode" class="form-control" value="<%= referralCode %>" required><div class="form-text">Use the referral number supplied for this patient.</div></div>
</div></div><div class="card-footer text-end"><button class="btn btn-primary">Register Patient</button></div></div></form>