<div class="d-flex justify-content-between align-items-center mb-3"><div><h4 class="mb-1">Agent Portal</h4><div class="text-muted small">Register patients, book OPD/tests and track referrals.</div></div><div class="d-flex gap-2"><a class="btn btn-primary" href="/agent/patients/new">Register Patient</a><a class="btn btn-outline-primary" href="/agent/opd/new">Book OPD</a><a class="btn btn-outline-success" href="/agent/tests/new">Book Test</a></div></div>
<div class="row g-3 mb-4">
<% [['Patients',stats.patients,'/agent/patients','people'],['OPD Bookings',stats.opd,'/agent/opd/new','calendar-check'],['Test Bookings',stats.tests,'/agent/tests/new','eyedropper'],['Referral Codes',stats.referrals,'/agent/referrals','share']].forEach(function(x){ %><div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="text-muted small"><i class="bi bi-<%= x[3] %>"></i> <%= x[0] %></div><div class="display-6 fw-semibold"><%= x[1] %></div><a class="small" href="<%= x[2] %>">Open</a></div></div></div><% }) %>
</div>
<div class="card"><div class="card-header d-flex justify-content-between align-items-center"><strong>Referral Performance</strong><a href="/agent/referrals">View all</a></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Provider</th><th>Referral Code</th><th>Patients</th><th>OPD</th><th>Tests</th><th>Total Activity</th></tr></thead><tbody><% referrals.forEach(function(r){ %><tr><td><%= r.provider_name || 'Legacy / Unmapped' %></td><td><%= r.provider_name || 'Legacy / Unmapped' %></td><td><code><%= r.referral_code %></code></td><td><%= r.patients %></td><td><%= r.opd %></td><td><%= r.tests %></td><td><strong><%= Number(r.patients)+Number(r.opd)+Number(r.tests) %></strong></td></tr><% }) %><% if(!referrals.length){ %><tr><td colspan="6" class="text-center text-muted py-3">No referral activity yet.</td></tr><% } %></tbody></table></div></div>