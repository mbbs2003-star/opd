<div class="d-flex justify-content-between align-items-center mb-3"><div><h4>Book Diagnostic Tests</h4><div class="small text-muted">Select one or more available tests for the patient.</div></div><a href="/agent" class="btn btn-outline-secondary btn-sm">Agent Dashboard</a></div>
<form method="POST" action="/agent/tests"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="card mb-3"><div class="card-body"><div class="row g-3">
<div class="col-md-6"><label class="form-label">Patient Health ID *</label><div class="input-group"><input name="healthId" class="form-control" value="<%= patient ? patient.health_id : '' %>" required><button type="button" class="btn btn-outline-secondary" onclick="location.href='/agent/tests/new?healthId='+encodeURIComponent(document.querySelector('[name=healthId]').value)">Find</button></div></div>
<div class="col-md-6"><label class="form-label">Referral Number / Code *</label><input name="referralCode" class="form-control" value="<%= referralCode %>" required></div>
<% if(patient){ %><div class="col-12"><div class="alert alert-success mb-0"><strong><%= patient.name %></strong> · <%= patient.health_id %> · <%= patient.mobile %></div></div><% } %>
<div class="col-md-4"><label class="form-label">Booking Date *</label><input type="date" name="bookingDate" class="form-control" value="<%= today %>" min="<%= today %>" required></div><div class="col-md-4"><label class="form-label">Priority</label><select name="priority" class="form-select"><option value="ROUTINE">Routine</option><option value="URGENT">Urgent</option></select></div><div class="col-md-4"><label class="form-label">Notes</label><input name="clinicalNotes" class="form-control"></div>
</div></div></div>
<div class="card"><div class="card-header"><strong>Available Tests</strong></div><div class="card-body"><div class="row g-2"><% tests.forEach(function(t){ %><div class="col-md-6 col-xl-4"><label class="border rounded p-3 d-block h-100"><div class="form-check"><input class="form-check-input" type="checkbox" name="testIds" value="<%= t.id %>"><span class="form-check-label fw-semibold"><%= t.name %></span></div><div class="small text-muted"><%= t.code %> · ₹<%= Number(t.price||0).toFixed(2) %><% if(t.specimen_type){ %> · <%= t.specimen_type %><% } %></div></label></div><% }) %></div></div><div class="card-footer text-end"><button class="btn btn-success btn-lg">Book Selected Tests</button></div></div></form>