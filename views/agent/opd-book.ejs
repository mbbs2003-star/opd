<div class="d-flex justify-content-between align-items-center mb-3"><div><h4>Book OPD</h4><div class="small text-muted">Agent booking is attributed to your account and referral number.</div></div><a href="/agent" class="btn btn-outline-secondary btn-sm">Agent Dashboard</a></div>
<form method="POST" action="/agent/opd"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="card mb-3"><div class="card-body"><div class="row g-3">
<div class="col-md-6"><label class="form-label">Patient Health ID *</label><div class="input-group"><input name="healthId" class="form-control" value="<%= patient ? patient.health_id : '' %>" required><button type="button" class="btn btn-outline-secondary" onclick="location.href='/agent/opd/new?healthId='+encodeURIComponent(document.querySelector('[name=healthId]').value)">Find</button></div></div>
<div class="col-md-6"><label class="form-label">Referral Number / Code *</label><input name="referralCode" class="form-control" value="<%= referralCode %>" required></div>
<% if(patient){ %><div class="col-12"><div class="alert alert-success mb-0"><strong><%= patient.name %></strong> · <%= patient.health_id %> · <%= patient.mobile %></div></div><% } %>
<div class="col-md-4"><label class="form-label">Department *</label><select name="departmentId" class="form-select" required><option value="">Select</option><% departments.forEach(function(d){ %><option value="<%= d.id %>"><%= d.name %></option><% }) %></select></div>
<div class="col-md-4"><label class="form-label">Doctor *</label><select name="doctorId" class="form-select" required><option value="">Select</option><% doctors.forEach(function(d){ %><option value="<%= d.id %>"><%= d.doctor_name %> — ₹<%= Number(d.consultation_fee||0).toFixed(0) %></option><% }) %></select></div>
<div class="col-md-4"><label class="form-label">Appointment Date *</label><input type="date" name="appointmentDate" class="form-control" min="<%= today %>" required></div>
<div class="col-md-4"><label class="form-label">Slot Time *</label><input type="time" name="slotTime" class="form-control" required></div>
<div class="col-md-8"><label class="form-label">Reason</label><input name="reason" class="form-control"></div>
</div></div></div>
<div class="card mb-3"><div class="card-header"><strong>Female / Obstetric Assessment</strong></div><div class="card-body"><div class="row g-3"><div class="col-md-3"><label class="form-label">Pregnancy Status</label><select name="pregnancyStatus" class="form-select"><option value="UNKNOWN">Unknown</option><option value="NOT_PREGNANT">Not Pregnant</option><option value="PREGNANT">Pregnant</option></select></div><div class="col-md-3"><label class="form-label">LMP</label><input type="date" name="lmpDate" class="form-control"></div><div class="col-md-2"><label class="form-label">Gravida (G)</label><input type="number" name="gravida" min="0" class="form-control"></div><div class="col-md-2"><label class="form-label">Para (P)</label><input type="number" name="para" min="0" class="form-control"></div><div class="col-md-2"><label class="form-label">Abortions</label><input type="number" name="abortions" min="0" class="form-control"></div><div class="col-12"><label class="form-label">Obstetric Notes</label><textarea name="obstetricNotes" class="form-control" rows="2"></textarea></div></div></div></div>
<div class="text-end"><button class="btn btn-primary btn-lg">Book OPD Appointment</button></div></form>