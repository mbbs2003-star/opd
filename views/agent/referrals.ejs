<div class="d-flex justify-content-between align-items-center mb-3"><div><h4>Referral Tracking</h4><div class="small text-muted">Branch-wide performance of referral numbers across patient registration, OPD and diagnostics.</div></div><a href="/agent" class="btn btn-outline-secondary btn-sm">Agent Dashboard</a></div>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Provider</th><th>Referral Number / Code</th><th>Patients Registered</th><th>OPD Bookings</th><th>Test Bookings</th><th>Total</th></tr></thead><tbody><% rows.forEach(function(r){ %><tr><td><%= r.provider_name || 'Legacy / Unmapped' %></td><td><code><%= r.referral_code %></code></td><td><strong><%= r.patients %></strong></td><td><strong><%= r.opd %></strong></td><td><strong><%= r.tests %></strong></td><td><span class="badge text-bg-primary"><%= Number(r.patients)+Number(r.opd)+Number(r.tests) %></span></td></tr><% }) %><% if(!rows.length){ %><tr><td colspan="6" class="text-center text-muted py-4">No referral codes have been used yet.</td></tr><% } %></tbody></table></div></div>